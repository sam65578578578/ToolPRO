{
  "schemaVersion": 1,
  "id": "toolpro",
  "version": "${version}",
  "name": "ToolPRO",
  "description": "A Meteor Client addon for crystal PvP: Auto D-Tap, configurable pearl mechanics, a Pearl Anchor module and an enhanced Auto Totem.",
  "authors": [
    "Fish-A-Man"
  ],
  "contact": {
    "sources": "https://github.com/sam65578578578/ToolPRO"
  },
  "icon": "assets/toolpro/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "com.toolpro.ToolPro"
    ]
  },
  "custom": {
    "meteor-client:color": "170,80,255",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=21",
    "minecraft": ["${mc_version}"],
    "meteor-client": "*"
  }
}
